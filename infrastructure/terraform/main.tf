# Ecoswift Bank - infrastructure-as-code entry point.
# Phase 1: structure only. No cloud resources are provisioned yet.

terraform {
  required_version = ">= 1.7"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}
