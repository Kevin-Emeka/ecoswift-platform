NODE_ENV=development

# apps/api gateway — health checks today, reserved for future cross-domain routes.
# Production: https://api.ecoswiftbank.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# Domain services called directly (see docs/architecture.md's note on why —
# each already ships its own auth/CORS/rate-limiting, no gateway needed yet).
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3000
NEXT_PUBLIC_ACCOUNT_API_URL=http://localhost:3003
NEXT_PUBLIC_NOTIFICATION_API_URL=http://localhost:3004
NEXT_PUBLIC_RECEIPT_API_URL=http://localhost:3005
