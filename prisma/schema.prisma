// =============================================================================
// IDENTITY
// =============================================================================

/// Authentication identity — the "who is logging in" record. Every User is
/// linked 1:1 to exactly one of Profile (always) and, depending on
/// `actorType`, to a Customer (banking data lives there, not here).
model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType           ActorType  @default(CUSTOMER) @map("actor_type")
  email               String     @unique
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phone               String?    @unique
  phoneVerifiedAt     DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  passwordHash        String     @map("password_hash")
  status              UserStatus @default(PENDING_VERIFICATION)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  version             Int        @default(0)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(6)

  profile                          Profile?
  customer                         Customer?
  devices                          Device[]
  sessions                         Session[]
  otpChallenges                    OtpChallenge[]
  twoFactorCredentials             TwoFactorCredential[]
  passwordHistory                  PasswordHistory[]
  userRoles                        UserRole[]               @relation("UserRoleUser")
  rolesAssigned                    UserRole[]               @relation("UserRoleAssignedBy")
  roleAssignmentApprovalsAsTarget  RoleAssignmentApproval[] @relation("RoleAssignmentApprovalUser")
  roleAssignmentApprovalsRequested RoleAssignmentApproval[] @relation("RoleAssignmentApprovalRequestedBy")
  roleAssignmentApprovalsReviewed  RoleAssignmentApproval[] @relation("RoleAssignmentApprovalReviewedBy")
  auditLogsAsActor                 AuditLog[]
  activityLogs                     ActivityLog[]
  securityEvents                   SecurityEvent[]
  loginHistory                     LoginHistory[]
  notificationsReceived            Notification[]
  apiKeys                          ApiKey[]
  webhookEndpoints                 WebhookEndpoint[]
  transactionsInitiated            Transaction[]
  journalEntriesCreated            JournalEntry[]
  financialPeriodsClosed           FinancialPeriod[]
  transferApprovalsMade            TransferApproval[]       @relation("TransferApprovalMaker")
  transferApprovalsChecked         TransferApproval[]       @relation("TransferApprovalChecker")
  kycApplicationsReviewed          KycApplication[]
  complianceNotesAuthored          ComplianceNote[]
  loanDecisions                    LoanApplication[]
  reportJobsRequested              ReportJob[]
  statementRequests                StatementRequest[]
  auditReportsGenerated            AuditReport[]
  applicationSettingsUpdated       ApplicationSetting[]
  systemSettingsUpdated            SystemSetting[]
  featureFlagsUpdated              FeatureFlag[]
  supportTicketsAssigned           SupportTicket[]
  ticketMessagesAuthored           TicketMessage[]

  @@map("users")
}

/// Personal-identity data shared by both customer and staff users. Kept
/// separate from `User` (auth) and `Customer` (banking) so the same shape
/// serves staff without dragging in banking-only fields.
model Profile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  firstName     String   @map("first_name")
  middleName    String?  @map("middle_name")
  lastName      String   @map("last_name")
  dateOfBirth   DateTime @map("date_of_birth") @db.Date
  gender        String?
  nationalityId String?  @map("nationality_id") @db.Uuid
  avatarUrl     String?  @map("avatar_url")

  // Phase 4A — Customer Profile additions. Address is kept as flat,
  // free-form fields (not FK'd to `Country`) since nothing here needs to
  // join against it the way `nationalityId`/`Account.currencyId` do;
  // `addressCountryCode` is validated as an ISO 3166-1 alpha-2 code at the
  // DTO layer (`packages/authz`-style catalog validation, not a DB
  // constraint) rather than a second, disambiguated relation to `Country`.
  addressLine1            String?                 @map("address_line1")
  addressLine2            String?                 @map("address_line2")
  city                    String?
  state                   String?
  postalCode              String?                 @map("postal_code")
  addressCountryCode      String?                 @map("address_country_code") @db.Char(2)
  occupation              String?
  preferredLanguage       String                  @default("en") @map("preferred_language")
  preferredCurrencyId     String?                 @map("preferred_currency_id") @db.Uuid
  timezone                String                  @default("UTC")
  profileCompletionStatus ProfileCompletionStatus @default(INCOMPLETE) @map("profile_completion_status")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationality       Country?  @relation(fields: [nationalityId], references: [id], onDelete: Restrict)
  preferredCurrency Currency? @relation(fields: [preferredCurrencyId], references: [id], onDelete: SetNull)

  @@map("profiles")
}

enum ProfileCompletionStatus {
  INCOMPLETE
  COMPLETE
}

/// A recognized client device, used for device-trust step-up decisions
/// (security-model.md § Device Trust).
model Device {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  deviceFingerprint String           @map("device_fingerprint")
  deviceName        String?          @map("device_name")
  platform          String?
  trustLevel        DeviceTrustLevel @default(UNTRUSTED) @map("trust_level")
  trustedAt         DateTime?        @map("trusted_at") @db.Timestamptz(6)
  lastSeenAt        DateTime         @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Phase 3C addition — Device Security § Risk Metadata. Last-observed
  /// network/client signals for this device, updated on every recognition
  /// (`DeviceService.recognize()`), *not* used to auto-block anything here —
  /// a data point for the Phase 3C fraud-detection hooks and any future
  /// staff-facing device review screen to read, never a decision made by
  /// this model itself.
  lastIpAddress     String?          @map("last_ip_address")
  riskScore         Decimal?         @map("risk_score") @db.Decimal(5, 2)
  riskMetadata      Json?            @map("risk_metadata")
  revokedAt         DateTime?        @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?          @map("revoked_reason")

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions         Session[]
  securityEvents   SecurityEvent[]
  loginHistory     LoginHistory[]
  pushQueueEntries PushQueue[]

  @@unique([userId, deviceFingerprint])
  @@index([userId])
  @@map("devices")
}

/// An issued login session. `accessTokenHash`/`refreshTokenHash` store only
/// hashes — the tokens themselves are never persisted server-side.
model Session {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  deviceId         String?       @map("device_id") @db.Uuid
  accessTokenHash  String?       @map("access_token_hash")
  refreshTokenHash String?       @map("refresh_token_hash")
  status           SessionStatus @default(ACTIVE)
  ipAddress        String        @map("ip_address")
  userAgent        String?       @map("user_agent")
  issuedAt         DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?       @map("revoked_reason")

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  loginHistory LoginHistory[]

  @@index([userId, status])
  @@index([expiresAt])
  @@map("sessions")
}

/// A one-time code issued for login step-up, password reset, transaction
/// confirmation, or 2FA enrollment (security-model.md § OTP Lifecycle).
model OtpChallenge {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  status      OtpStatus  @default(PENDING)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  verifiedAt  DateTime?  @map("verified_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, status])
  @@map("otp_challenges")
}

/// An enrolled 2FA method. `secretEncrypted` holds an application-layer
/// encrypted TOTP seed (never plaintext) — see security-model.md §
/// Encryption Boundaries.
model TwoFactorCredential {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  method          TwoFactorMethodType
  secretEncrypted String?             @map("secret_encrypted")
  isEnabled       Boolean             @default(false) @map("is_enabled")
  enrolledAt      DateTime            @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  disabledAt      DateTime?           @map("disabled_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupCodes BackupCode[]

  @@unique([userId, method])
  @@map("two_factor_credentials")
}

/// Single-use recovery codes issued alongside 2FA enrollment.
model BackupCode {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  twoFactorCredentialId String    @map("two_factor_credential_id") @db.Uuid
  codeHash              String    @map("code_hash")
  usedAt                DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  twoFactorCredential TwoFactorCredential @relation(fields: [twoFactorCredentialId], references: [id], onDelete: Cascade)

  @@index([twoFactorCredentialId])
  @@map("backup_codes")
}

/// Previous password hashes, retained only to enforce
/// `PasswordRotationPolicy` (business-rules.md § Password Policy — "a new
/// password must not match any of the customer's last N passwords").
/// Phase 3A addition to Identity — additive migration, no existing table
/// changed. Never used for anything except the reuse check: rows are
/// write-once, read-only-during-password-change, never displayed or
/// exported.
model PasswordHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

/// A staff/system role — see docs/rbac.md for the canonical 10-role
/// catalog (seeded in prisma/seed.ts). Phase 3A seeded 7 legacy names
/// (Phase 2B placeholder); Phase 3B is the first phase that actually
/// implements role management, and renames/re-seeds to the Phase 3B brief's
/// canonical list.
model Role {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  /// Phase 3B addition — role hierarchy (docs/rbac.md § Role Hierarchy):
  /// a role inherits every permission its parent (and the parent's
  /// ancestors) grants, in addition to its own directly-granted
  /// permissions. Nullable: most roles in the seeded catalog are lateral
  /// specialist roles with no parent; only the admin lineage
  /// (System Administrator → Super Administrator) actually chains.
  parentRoleId String?  @map("parent_role_id") @db.Uuid
  /// Phase 3B addition — assigning this role to a user requires maker-checker
  /// approval (RoleAssignmentApproval) rather than taking effect immediately.
  /// Reserved for roles broad enough that self-service or single-actor
  /// assignment would be a privilege-escalation risk (System Administrator,
  /// Super Administrator in the seeded catalog).
  isSensitive  Boolean  @default(false) @map("is_sensitive")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parentRole       Role?                    @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: SetNull)
  childRoles       Role[]                   @relation("RoleHierarchy")
  rolePermissions  RolePermission[]
  userRoles        UserRole[]
  approvalRequests RoleAssignmentApproval[]

  @@map("roles")
}

/// Maker-checker gate for assigning a `Role` where `isSensitive = true`
/// (docs/compliance-controls.md § Administrative Approval Hooks). The
/// `UserRole` row is only created once an approval here is `APPROVED` —
/// requesting a sensitive role assignment never grants it immediately, no
/// matter who requests it, including a Super Administrator (the checker
/// must still be a *different* actor than the maker — enforced in
/// `RoleAssignmentApprovalService`, not just by convention).
model RoleAssignmentApproval {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  roleId      String         @map("role_id") @db.Uuid
  requestedBy String         @map("requested_by") @db.Uuid
  status      ApprovalStatus @default(PENDING)
  reviewedBy  String?        @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  reviewNote  String?        @map("review_note")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user            User  @relation("RoleAssignmentApprovalUser", fields: [userId], references: [id], onDelete: Cascade)
  role            Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  requestedByUser User  @relation("RoleAssignmentApprovalRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  reviewedByUser  User? @relation("RoleAssignmentApprovalReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("role_assignment_approvals")
}

/// A single grantable capability, `resource:action` shaped (e.g.
/// `accounts:freeze`). Composed into roles via RolePermission.
model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user           User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role           Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser User? @relation("UserRoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
}

// =============================================================================
// ACCOUNT MANAGEMENT
// =============================================================================

/// The banking-specific extension of a User with `actorType = CUSTOMER`.
/// Personal identity data lives on `Profile`; this holds banking state.
model Customer {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String         @unique @map("user_id") @db.Uuid
  customerNumber String         @unique @map("customer_number")
  tier           KycTier        @default(TIER_0)
  status         CustomerStatus @default(ACTIVE)
  countryId      String         @map("country_id") @db.Uuid
  riskRating     Decimal?       @map("risk_rating") @db.Decimal(5, 2)
  dateJoined     DateTime       @default(now()) @map("date_joined") @db.Timestamptz(6)
  version        Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  country            Country             @relation(fields: [countryId], references: [id], onDelete: Restrict)
  accounts           Account[]
  beneficiaries      Beneficiary[]
  transferLimits     TransferLimit[]
  scheduledTransfers ScheduledTransfer[]
  kycApplications    KycApplication[]
  loanApplications   LoanApplication[]
  loans              Loan[]
  savingsAccounts    SavingsAccount[]
  notifications      Notification[]
  supportTickets     SupportTicket[]
  consents           CustomerConsent[]

  @@index([tier])
  @@map("customers")
}

enum ConsentType {
  TERMS_AND_CONDITIONS
  PRIVACY_POLICY
  MARKETING_COMMUNICATIONS
}

/// Phase 4A — an append-only acceptance/withdrawal log, never updated or
/// deleted: compliance needs to know not just the current opt-in/opt-out
/// state but *which version* of a legal document a customer accepted and
/// *when*. Current status for a `consentType` is the most recent row by
/// `createdAt`; `MARKETING_COMMUNICATIONS` reuses the same log by writing
/// a new row each time the preference is toggled (`version` is a constant
/// for this type since there's no versioned document behind it).
model CustomerConsent {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String      @map("customer_id") @db.Uuid
  consentType ConsentType @map("consent_type")
  version     String
  accepted    Boolean
  acceptedAt  DateTime    @map("accepted_at") @db.Timestamptz(6)
  ipAddress   String?     @map("ip_address")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, consentType, createdAt])
  @@map("customer_consents")
}

/// The product catalog for account types (extensible without a migration —
/// contrast with `AccountStatus`, which is a fixed enum by design since it's
/// a finite state machine, not a product configuration).
model AccountType {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String   @unique
  name                  String
  description           String?
  allowsOverdraft       Boolean  @default(false) @map("allows_overdraft")
  minimumOpeningBalance Decimal  @default(0) @map("minimum_opening_balance") @db.Decimal(19, 4)
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  accounts Account[]

  @@map("account_types")
}

/// A customer bank account. The account's balance is never stored here —
/// see `AccountBalance` (cache) and `LedgerAccount`/`JournalLine` (source of
/// truth). This table is the product/record of the account, not the money.
model Account {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountNumber String        @unique @map("account_number")
  customerId    String        @map("customer_id") @db.Uuid
  accountTypeId String        @map("account_type_id") @db.Uuid
  currencyId    String        @map("currency_id") @db.Uuid
  status        AccountStatus @default(PENDING_ACTIVATION)
  openedAt      DateTime      @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt      DateTime?     @map("closed_at") @db.Timestamptz(6)
  version       Int           @default(0)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer                        Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  accountType                     AccountType         @relation(fields: [accountTypeId], references: [id], onDelete: Restrict)
  currency                        Currency            @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  ledgerAccount                   LedgerAccount?
  balance                         AccountBalance?
  savingsAccount                  SavingsAccount?
  loansDisbursedTo                Loan[]
  transferLimits                  TransferLimit[]
  statements                      Statement[]
  statementRequests               StatementRequest[]
  transactionsAsSource            Transaction[]       @relation("TransactionSourceAccount")
  transactionsAsDestination       Transaction[]       @relation("TransactionDestinationAccount")
  transferRequestsAsSource        TransferRequest[]   @relation("TransferRequestSourceAccount")
  transferRequestsAsDestination   TransferRequest[]   @relation("TransferRequestDestinationAccount")
  scheduledTransfersAsSource      ScheduledTransfer[] @relation("ScheduledTransferSourceAccount")
  scheduledTransfersAsDestination ScheduledTransfer[] @relation("ScheduledTransferDestinationAccount")

  @@index([customerId])
  @@index([status])
  @@map("accounts")
}

/// ISO 4217 currency catalog.
model Currency {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isoCode        String         @unique @map("iso_code") @db.Char(3)
  name           String
  symbol         String
  decimalPlaces  Int            @default(2) @map("decimal_places")
  status         CurrencyStatus @default(ACTIVE)
  isBaseCurrency Boolean        @default(false) @map("is_base_currency")

  accounts             Account[]
  beneficiaries        Beneficiary[]
  transferLimits       TransferLimit[]
  scheduledTransfers   ScheduledTransfer[]
  feeSchedules         FeeSchedule[]
  transactionFees      TransactionFee[]
  transactions         Transaction[]
  journalLines         JournalLine[]
  collaterals          Collateral[]
  exchangeRatesAsBase  ExchangeRate[]      @relation("ExchangeRateBaseCurrency")
  exchangeRatesAsQuote ExchangeRate[]      @relation("ExchangeRateQuoteCurrency")
  preferredByProfiles  Profile[]

  @@map("currencies")
}

/// ISO 3166-1 country catalog.
model Country {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isoCode     String  @unique @map("iso_code") @db.Char(2)
  name        String
  dialingCode String? @map("dialing_code")
  isActive    Boolean @default(true) @map("is_active")

  profiles  Profile[]
  customers Customer[]

  @@map("countries")
}

/// An external payee saved by a customer for repeat transfers. Deliberately
/// not FK'd to `Account` — beneficiaries are typically at other banks.
model Beneficiary {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String            @map("customer_id") @db.Uuid
  beneficiaryName String            @map("beneficiary_name")
  accountNumber   String            @map("account_number")
  bankName        String?           @map("bank_name")
  bankCode        String?           @map("bank_code")
  // International-wire detail, added alongside the inline wire-transfer
  // flow (ExternalTransferService no longer requires a pre-saved,
  // separately-verified beneficiary — see that service's doc comment).
  // Flat/free-form rather than FK'd to `Country`, matching
  // `Profile.addressCountryCode`'s precedent for exactly this reason.
  swiftBic        String?           @map("swift_bic")
  bankAddress     String?           @map("bank_address")
  bankCountryCode String?           @map("bank_country_code") @db.Char(2)
  routingNumber   String?           @map("routing_number")
  currencyId      String            @map("currency_id") @db.Uuid
  nickname        String?
  isFavorite      Boolean           @default(false) @map("is_favorite")
  status          BeneficiaryStatus @default(PENDING_VERIFICATION)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)

  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currency           Currency            @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  transferRequests   TransferRequest[]
  scheduledTransfers ScheduledTransfer[]

  @@index([customerId])
  @@map("beneficiaries")
}

// =============================================================================
// ACCOUNTING / LEDGER
// =============================================================================
// See docs/ledger-design.md for the full double-entry model. Summary: the
// "General Ledger" and "Chart of Accounts" named in the brief are not
// separate tables — they are what LedgerAccount + JournalEntry + JournalLine
// collectively *are*, per standard double-entry accounting theory. Inventing
// a redundant "GeneralLedger" table would just be a second, driftable copy.

/// Top-level chart-of-accounts classification (the five fundamental
/// accounting categories) and each category's normal balance side.
model AccountCategory {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String            @unique
  name          String
  type          LedgerAccountType
  normalBalance NormalBalance     @map("normal_balance")
  description   String?

  ledgerAccounts LedgerAccount[]

  @@map("account_categories")
}

/// A chart-of-accounts leaf entry. Every customer-facing `Account` has
/// exactly one corresponding `LedgerAccount` (its position in the general
/// ledger); internal bank accounts (e.g. "Interest Income", "Fee Revenue")
/// have `customerAccountId = null`.
model LedgerAccount {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String   @unique
  name              String
  categoryId        String   @map("category_id") @db.Uuid
  customerAccountId String?  @unique @map("customer_account_id") @db.Uuid
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  category        AccountCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  customerAccount Account?        @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  journalLines    JournalLine[]
  balance         AccountBalance?

  @@index([categoryId])
  @@map("ledger_accounts")
}

/// A read-optimized, eventually-consistent balance projection (CQRS read
/// model). NEVER the source of truth — always reconcilable by summing
/// `JournalLine`s for the same `ledgerAccountId`. See ledger-design.md.
model AccountBalance {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId         String    @unique @map("account_id") @db.Uuid
  ledgerAccountId   String    @unique @map("ledger_account_id") @db.Uuid
  availableBalance  Decimal   @default(0) @map("available_balance") @db.Decimal(19, 4)
  currentBalance    Decimal   @default(0) @map("current_balance") @db.Decimal(19, 4)
  lastJournalLineId String?   @map("last_journal_line_id") @db.Uuid
  lastReconciledAt  DateTime? @map("last_reconciled_at") @db.Timestamptz(6)
  version           Int       @default(0)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  account       Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@map("account_balances")
}

/// An immutable, balanced financial journal entry. `IsBalancedEntrySpec`
/// (business-rules.md) is enforced at the application layer AND, in
/// production, by a deferred database trigger — see the balance-check
/// trigger in the initial migration. Never updated or deleted; a mistake is
/// corrected by posting a new entry referencing this one via
/// `reversalOfJournalEntryId`.
model JournalEntry {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalNumber            String             @unique @map("journal_number")
  transactionId            String?            @map("transaction_id") @db.Uuid
  description              String
  financialPeriodId        String             @map("financial_period_id") @db.Uuid
  status                   JournalEntryStatus @default(POSTED)
  reversalOfJournalEntryId String?            @unique @map("reversal_of_journal_entry_id") @db.Uuid
  createdBy                String?            @map("created_by") @db.Uuid
  postedAt                 DateTime           @default(now()) @map("posted_at") @db.Timestamptz(6)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction      Transaction?             @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  financialPeriod  FinancialPeriod          @relation(fields: [financialPeriodId], references: [id], onDelete: Restrict)
  createdByUser    User?                    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  reversalOf       JournalEntry?            @relation("JournalEntryReversal", fields: [reversalOfJournalEntryId], references: [id], onDelete: Restrict)
  reversedBy       JournalEntry?            @relation("JournalEntryReversal")
  lines            JournalLine[]
  interestPostings InterestPostingHistory[]

  @@index([transactionId])
  @@index([financialPeriodId])
  @@map("journal_entries")
}

/// A single debit or credit posting within a `JournalEntry`. `amount` is
/// always positive; direction (debit/credit) carries the sign meaning. The
/// sum of DEBIT lines must equal the sum of CREDIT lines per journal entry,
/// per currency — enforced by the deferred trigger, not just app code.
model JournalLine {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalEntryId  String        @map("journal_entry_id") @db.Uuid
  ledgerAccountId String        @map("ledger_account_id") @db.Uuid
  lineNumber      Int           @map("line_number")
  direction       NormalBalance
  amount          Decimal       @db.Decimal(19, 4)
  currencyId      String        @map("currency_id") @db.Uuid
  description     String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  journalEntry  JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  currency      Currency      @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, lineNumber])
  @@index([ledgerAccountId, createdAt])
  @@index([journalEntryId])
  @@map("journal_lines")
}

/// An accounting period (typically monthly). `LOCKED` periods reject any
/// new `JournalEntry` referencing them — see database-architecture.md.
model FinancialPeriod {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String                @unique
  startDate DateTime              @map("start_date") @db.Date
  endDate   DateTime              @map("end_date") @db.Date
  status    FinancialPeriodStatus @default(OPEN)
  closedAt  DateTime?             @map("closed_at") @db.Timestamptz(6)
  closedBy  String?               @map("closed_by") @db.Uuid

  closedByUser   User?          @relation(fields: [closedBy], references: [id], onDelete: SetNull)
  journalEntries JournalEntry[]

  @@index([startDate, endDate])
  @@map("financial_periods")
}

// =============================================================================
// TRANSACTIONS
// =============================================================================

/// Extensible catalog of transaction kinds (deposit, withdrawal, transfer,
/// loan disbursement, etc.) — adding a new kind is data, not a migration.
model TransactionType {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  transactions Transaction[]
  feeSchedules FeeSchedule[]

  @@map("transaction_types")
}

/// The record of any money-movement request — deposits, withdrawals,
/// transfers, fee charges, loan disbursements, interest postings all flow
/// through here. `TransferRequest` extends this for transfer-specific
/// fields; deposits/withdrawals/fees use this table alone.
model Transaction {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionReference String            @unique @map("transaction_reference")
  transactionTypeId    String            @map("transaction_type_id") @db.Uuid
  sourceAccountId      String?           @map("source_account_id") @db.Uuid
  destinationAccountId String?           @map("destination_account_id") @db.Uuid
  amount               Decimal           @db.Decimal(19, 4)
  currencyId           String            @map("currency_id") @db.Uuid
  status               TransactionStatus @default(INITIATED)
  idempotencyKey       String?           @unique @map("idempotency_key")
  initiatedBy          String?           @map("initiated_by") @db.Uuid
  description          String?
  metadata             Json?
  failureReason        String?           @map("failure_reason")
  completedAt          DateTime?         @map("completed_at") @db.Timestamptz(6)
  failedAt             DateTime?         @map("failed_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  transactionType       TransactionType     @relation(fields: [transactionTypeId], references: [id], onDelete: Restrict)
  sourceAccount         Account?            @relation("TransactionSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount    Account?            @relation("TransactionDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  currency              Currency            @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  initiatedByUser       User?               @relation(fields: [initiatedBy], references: [id], onDelete: SetNull)
  journalEntries        JournalEntry[]
  transferRequest       TransferRequest?
  fees                  TransactionFee[]
  repaymentInstallments RepaymentSchedule[]
  receipts              Receipt[]

  @@index([status])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([createdAt])
  @@map("transactions")
}

enum ReceiptFormat {
  PDF
  CSV
  JSON
}

/// Milestone 1 — a durable, queryable record of `receipt-service`'s
/// `RECEIPTS_QUEUE` consumer output. `content` is a self-contained JSON
/// snapshot (reference, amount, parties, timestamps) rather than a FK web
/// back into `Transaction`/`Account`, so a receipt continues to render
/// correctly exactly as issued even if the underlying records are later
/// modified. Only `JSON` is actually generated in this milestone — `PDF`/`CSV`
/// are modeled (`ReceiptJobPayload.format`, Phase 2C) but not implemented.
model Receipt {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId   String        @map("transaction_id") @db.Uuid
  referenceNumber String        @unique @map("reference_number")
  format          ReceiptFormat
  content         Json
  generatedAt     DateTime      @default(now()) @map("generated_at") @db.Timestamptz(6)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("receipts")
}

/// Transfer-specific extension of a `Transaction` (1:1) — channel, narrative,
/// and beneficiary detail that only apply to transfers.
model TransferRequest {
  id                       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId            String          @unique @map("transaction_id") @db.Uuid
  transferChannel          TransferChannel @map("transfer_channel")
  sourceAccountId          String          @map("source_account_id") @db.Uuid
  destinationAccountId     String?         @map("destination_account_id") @db.Uuid
  destinationBeneficiaryId String?         @map("destination_beneficiary_id") @db.Uuid
  requestedAmount          Decimal         @map("requested_amount") @db.Decimal(19, 4)
  narrative                String?
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction            Transaction        @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  sourceAccount          Account            @relation("TransferRequestSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount     Account?           @relation("TransferRequestDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  destinationBeneficiary Beneficiary?       @relation(fields: [destinationBeneficiaryId], references: [id], onDelete: Restrict)
  approvals              TransferApproval[]

  @@map("transfer_requests")
}

/// Daily/per-transaction/monthly transfer ceilings, scoped by customer,
/// account, and/or KYC tier (business-rules.md § Daily Limits).
model TransferLimit {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId          String?   @map("customer_id") @db.Uuid
  accountId           String?   @map("account_id") @db.Uuid
  tier                KycTier?
  dailyLimit          Decimal   @map("daily_limit") @db.Decimal(19, 4)
  perTransactionLimit Decimal   @map("per_transaction_limit") @db.Decimal(19, 4)
  monthlyLimit        Decimal   @map("monthly_limit") @db.Decimal(19, 4)
  currencyId          String    @map("currency_id") @db.Uuid
  effectiveFrom       DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo         DateTime? @map("effective_to") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  account  Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  currency Currency  @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([accountId])
  @@map("transfer_limits")
}

/// Maker-checker approval record for a transfer above the auto-approval
/// threshold (security-model.md § Permissions Model).
model TransferApproval {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transferRequestId String         @map("transfer_request_id") @db.Uuid
  requiredApprovals Int            @default(1) @map("required_approvals")
  status            ApprovalStatus @default(PENDING)
  makerId           String         @map("maker_id") @db.Uuid
  checkerId         String?        @map("checker_id") @db.Uuid
  makerActionAt     DateTime       @default(now()) @map("maker_action_at") @db.Timestamptz(6)
  checkerActionAt   DateTime?      @map("checker_action_at") @db.Timestamptz(6)
  comments          String?

  transferRequest TransferRequest @relation(fields: [transferRequestId], references: [id], onDelete: Cascade)
  maker           User            @relation("TransferApprovalMaker", fields: [makerId], references: [id], onDelete: Restrict)
  checker         User?           @relation("TransferApprovalChecker", fields: [checkerId], references: [id], onDelete: SetNull)

  @@index([transferRequestId])
  @@map("transfer_approvals")
}

/// A future-dated or repeating transfer instruction. `ONE_TIME` runs once
/// at `nextRunAt` and moves to `COMPLETED`; `DAILY`/`WEEKLY`/`MONTHLY` keep
/// re-executing, advancing `nextRunAt` each time, until cancelled or
/// `endDate` passes. Execution itself happens through the exact same
/// `InternalTransferService`/`ExternalTransferService` a same-day transfer
/// uses — this table only ever records *intent*; it never posts a ledger
/// entry directly (see `ScheduledTransferWorker`).
model ScheduledTransfer {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId               String                  @map("customer_id") @db.Uuid
  sourceAccountId          String                  @map("source_account_id") @db.Uuid
  transferChannel          TransferChannel         @map("transfer_channel")
  destinationAccountId     String?                 @map("destination_account_id") @db.Uuid
  destinationBeneficiaryId String?                 @map("destination_beneficiary_id") @db.Uuid
  amount                   Decimal                 @db.Decimal(19, 4)
  currencyId               String                  @map("currency_id") @db.Uuid
  description              String?
  frequency                ScheduleFrequency
  nextRunAt                DateTime                @map("next_run_at") @db.Timestamptz(6)
  endDate                  DateTime?               @map("end_date") @db.Timestamptz(6)
  status                   ScheduledTransferStatus @default(SCHEDULED)
  lastRunAt                DateTime?               @map("last_run_at") @db.Timestamptz(6)
  lastTransactionId        String?                 @map("last_transaction_id") @db.Uuid
  failureReason            String?                 @map("failure_reason")
  cancelledAt              DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer               Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sourceAccount          Account      @relation("ScheduledTransferSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount     Account?     @relation("ScheduledTransferDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  destinationBeneficiary Beneficiary? @relation(fields: [destinationBeneficiaryId], references: [id], onDelete: Restrict)
  currency               Currency     @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([status, nextRunAt])
  @@map("scheduled_transfers")
}

/// Fee catalog/schedule (flat or percentage-based, optionally scoped to a
/// transaction type).
model FeeSchedule {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String             @unique
  name              String
  transactionTypeId String?            @map("transaction_type_id") @db.Uuid
  calculationType   FeeCalculationType @map("calculation_type")
  flatAmount        Decimal?           @map("flat_amount") @db.Decimal(19, 4)
  percentageRate    Decimal?           @map("percentage_rate") @db.Decimal(6, 4)
  minFee            Decimal?           @map("min_fee") @db.Decimal(19, 4)
  maxFee            Decimal?           @map("max_fee") @db.Decimal(19, 4)
  currencyId        String?            @map("currency_id") @db.Uuid
  isActive          Boolean            @default(true) @map("is_active")

  transactionType TransactionType? @relation(fields: [transactionTypeId], references: [id], onDelete: SetNull)
  currency        Currency?        @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  transactionFees TransactionFee[]

  @@map("fee_schedules")
}

/// The fee actually charged against a specific transaction.
model TransactionFee {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  feeScheduleId String   @map("fee_schedule_id") @db.Uuid
  amount        Decimal  @db.Decimal(19, 4)
  currencyId    String   @map("currency_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  feeSchedule FeeSchedule @relation(fields: [feeScheduleId], references: [id], onDelete: Restrict)
  currency    Currency    @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@map("transaction_fees")
}

/// FX rate snapshots. `rate` converts 1 unit of base currency into quote
/// currency at `effectiveAt`.
model ExchangeRate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  baseCurrencyId  String   @map("base_currency_id") @db.Uuid
  quoteCurrencyId String   @map("quote_currency_id") @db.Uuid
  rate            Decimal  @db.Decimal(18, 8)
  source          String?
  effectiveAt     DateTime @map("effective_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  baseCurrency  Currency @relation("ExchangeRateBaseCurrency", fields: [baseCurrencyId], references: [id], onDelete: Restrict)
  quoteCurrency Currency @relation("ExchangeRateQuoteCurrency", fields: [quoteCurrencyId], references: [id], onDelete: Restrict)

  @@unique([baseCurrencyId, quoteCurrencyId, effectiveAt])
  @@index([baseCurrencyId, quoteCurrencyId])
  @@map("exchange_rates")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model NotificationTemplate {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String              @unique
  channel         NotificationChannel
  subjectTemplate String?             @map("subject_template")
  bodyTemplate    String              @map("body_template")
  locale          String              @default("en")
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  notifications Notification[]

  @@unique([code, locale])
  @@map("notification_templates")
}

model Notification {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId     String?              @map("recipient_user_id") @db.Uuid
  recipientCustomerId String?              @map("recipient_customer_id") @db.Uuid
  templateId          String               @map("template_id") @db.Uuid
  channel             NotificationChannel
  priority            NotificationPriority @default(NORMAL)
  status              NotificationStatus   @default(QUEUED)
  payload             Json?
  renderedSubject     String?              @map("rendered_subject")
  renderedBody        String?              @map("rendered_body")
  suppressedReason    String?              @map("suppressed_reason")
  sentAt              DateTime?            @map("sent_at") @db.Timestamptz(6)
  readAt              DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  recipientUser     User?                @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientCustomer Customer?            @relation(fields: [recipientCustomerId], references: [id], onDelete: SetNull)
  template          NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  emailQueue        EmailQueue?
  smsQueue          SmsQueue?
  pushQueue         PushQueue?
  auditNotification AuditNotification?

  @@index([recipientUserId, status])
  @@index([createdAt])
  @@map("notifications")
}

model EmailQueue {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String      @unique @map("notification_id") @db.Uuid
  toAddress         String      @map("to_address")
  fromAddress       String      @map("from_address")
  subject           String
  bodyHtml          String?     @map("body_html")
  bodyText          String?     @map("body_text")
  status            QueueStatus @default(PENDING)
  attempts          Int         @default(0)
  maxAttempts       Int         @default(5) @map("max_attempts")
  lastAttemptAt     DateTime?   @map("last_attempt_at") @db.Timestamptz(6)
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(6)
  providerMessageId String?     @map("provider_message_id")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("email_queue")
}

model SmsQueue {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String      @unique @map("notification_id") @db.Uuid
  toNumber          String      @map("to_number")
  message           String
  status            QueueStatus @default(PENDING)
  attempts          Int         @default(0)
  maxAttempts       Int         @default(5) @map("max_attempts")
  lastAttemptAt     DateTime?   @map("last_attempt_at") @db.Timestamptz(6)
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(6)
  providerMessageId String?     @map("provider_message_id")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("sms_queue")
}

model PushQueue {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String      @unique @map("notification_id") @db.Uuid
  deviceId          String?     @map("device_id") @db.Uuid
  title             String
  body              String
  status            QueueStatus @default(PENDING)
  attempts          Int         @default(0)
  maxAttempts       Int         @default(5) @map("max_attempts")
  lastAttemptAt     DateTime?   @map("last_attempt_at") @db.Timestamptz(6)
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(6)
  providerMessageId String?     @map("provider_message_id")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("push_queue")
}

/// Flags which `Notification` rows are the non-suppressible security class
/// (business-rules.md § Notification Triggers) and links them to the audit
/// trail that triggered them.
model AuditNotification {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId     String   @unique @map("notification_id") @db.Uuid
  auditLogId         String?  @map("audit_log_id") @db.Uuid
  isSecurityCritical Boolean  @default(true) @map("is_security_critical")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  auditLog     AuditLog?    @relation(fields: [auditLogId], references: [id], onDelete: SetNull)

  @@map("audit_notifications")
}

