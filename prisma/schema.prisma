  account Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  request StatementRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([accountId, periodStart])
  @@map("statements")
}

model StatementRequest {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestedBy String          @map("requested_by") @db.Uuid
  accountId   String          @map("account_id") @db.Uuid
  periodStart DateTime        @map("period_start") @db.Date
  periodEnd   DateTime        @map("period_end") @db.Date
  format      ReportFormat
  status      ReportJobStatus @default(QUEUED)
  completedAt DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  requestedByUser User        @relation(fields: [requestedBy], references: [id], onDelete: Restrict)
  account         Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)
