// =============================================================================
// Ecoswift Bank — Enterprise Database Schema
// Phase 2B — Enterprise Database & Ledger Architecture
// =============================================================================
//
// Conventions (see docs/database-architecture.md for full rationale):
//   - Primary keys: UUID, generated by Postgres (`gen_random_uuid()`, pgcrypto).
//   - Timestamps: UTC, `timestamptz`. `createdAt` / `updatedAt` on every model
//     that isn't purely a join table; `deletedAt` (soft delete) only where a
//     hard delete would destroy financial/audit history that must be kept.
//   - Money: `Decimal(19, 4)`. Never `Float`/`Int` — floating point has no
//     place near currency.
//   - Table names: snake_case, plural (`@@map`). Column names: Prisma's
//     default camelCase is kept as-is (idiomatic Prisma/Postgres), except
//     multi-word columns are explicitly mapped to snake_case (`@map`) so raw
//     SQL / BI tooling outside Prisma sees conventional identifiers.
//   - The ledger (JournalEntry + JournalLine) is the single source of truth
//     for money. AccountBalance is a read-optimized, reconcilable cache —
//     see docs/ledger-design.md. This is non-negotiable per the Phase 2B
//     brief: no mutable balance is ever the source of truth.
//   - Optimistic locking (`version Int`) is applied to aggregates that face
//     concurrent writes from multiple actors (Account, Loan, SavingsAccount,
//     AccountBalance) — not applied blanket, since most tables here are
//     either append-only or single-writer.
//   - Check constraints beyond what Prisma's DSL supports (balanced journal
//     entries, positive amounts, ISO code lengths) are added via raw SQL in
//     the migration — see prisma/migrations/<ts>_init_banking_schema/.

generator client {
  provider      = "prisma-client-js"
  output        = "../packages/database/generated/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

