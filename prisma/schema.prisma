// SAVINGS
// =============================================================================

model SavingsProduct {
  id                         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                       String                    @unique
  name                       String
  planType                   SavingsPlanType           @map("plan_type")
  interestRate               Decimal                   @map("interest_rate") @db.Decimal(6, 4)
  interestCalculationMethod  InterestCalculationMethod @map("interest_calculation_method")
  minimumBalance             Decimal                   @default(0) @map("minimum_balance") @db.Decimal(19, 4)
  minTermMonths              Int?                      @map("min_term_months")
  maxTermMonths              Int?                      @map("max_term_months")
  earlyWithdrawalPenaltyRate Decimal?                  @map("early_withdrawal_penalty_rate") @db.Decimal(6, 4)
  isActive                   Boolean                   @default(true) @map("is_active")

  savingsAccounts SavingsAccount[]
  interestRules   InterestRule[]

  @@map("savings_products")
}

model SavingsAccount {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String        @map("customer_id") @db.Uuid
  savingsProductId String        @map("savings_product_id") @db.Uuid
  linkedAccountId  String        @unique @map("linked_account_id") @db.Uuid
  goalAmount       Decimal?      @map("goal_amount") @db.Decimal(19, 4)
  maturityDate     DateTime?     @map("maturity_date") @db.Date
  status           SavingsStatus @default(ACTIVE)
  autoRenew        Boolean       @default(false) @map("auto_renew")
  openedAt         DateTime      @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt         DateTime?     @map("closed_at") @db.Timestamptz(6)
  version          Int           @default(0)

  customer         Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  savingsProduct   SavingsProduct           @relation(fields: [savingsProductId], references: [id], onDelete: Restrict)
  linkedAccount    Account                  @relation(fields: [linkedAccountId], references: [id], onDelete: Restrict)
  interestPostings InterestPostingHistory[]

  @@index([customerId])
  @@index([status])
  @@map("savings_accounts")
}

/// Tiered interest rate rules for a savings product (e.g. higher balance
/// tiers earn a higher rate).
model InterestRule {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  savingsProductId String    @map("savings_product_id") @db.Uuid
  tierMinBalance   Decimal?  @map("tier_min_balance") @db.Decimal(19, 4)
  tierMaxBalance   Decimal?  @map("tier_max_balance") @db.Decimal(19, 4)
  rate             Decimal   @db.Decimal(6, 4)
  effectiveFrom    DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo      DateTime? @map("effective_to") @db.Timestamptz(6)

  savingsProduct SavingsProduct @relation(fields: [savingsProductId], references: [id], onDelete: Cascade)

  @@index([savingsProductId])
  @@map("interest_rules")
}

/// Realized interest postings — every row here is backed by a
/// `JournalEntry` (interest is never applied by mutating a balance
/// directly, per business-rules.md § Interest Calculation).
model InterestPostingHistory {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  savingsAccountId String   @map("savings_account_id") @db.Uuid
  period           String
  principalBalance Decimal  @map("principal_balance") @db.Decimal(19, 4)
  interestRate     Decimal  @map("interest_rate") @db.Decimal(6, 4)
  interestAmount   Decimal  @map("interest_amount") @db.Decimal(19, 4)
  journalEntryId   String?  @map("journal_entry_id") @db.Uuid
  postedAt         DateTime @default(now()) @map("posted_at") @db.Timestamptz(6)

  savingsAccount SavingsAccount @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)
  journalEntry   JournalEntry?  @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([savingsAccountId, period])
  @@map("interest_posting_history")
}

