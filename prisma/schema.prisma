}

model ReportJob {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportType   ReportType      @map("report_type")
  requestedBy  String?         @map("requested_by") @db.Uuid
  parameters   Json?
  status       ReportJobStatus @default(QUEUED)
  startedAt    DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime?       @map("completed_at") @db.Timestamptz(6)
  fileUrl      String?         @map("file_url")
  errorMessage String?         @map("error_message")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  requestedByUser User?        @relation(fields: [requestedBy], references: [id], onDelete: SetNull)
  auditReport     AuditReport?

  @@index([status])
  @@map("report_jobs")
}

model AuditReport {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportJobId String   @unique @map("report_job_id") @db.Uuid
  title       String
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  summary     String?
  fileUrl     String?  @map("file_url")
  generatedBy String?  @map("generated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reportJob       ReportJob @relation(fields: [reportJobId], references: [id], onDelete: Cascade)
  generatedByUser User?     @relation(fields: [generatedBy], references: [id], onDelete: SetNull)

  @@map("audit_reports")
}

// =============================================================================
// AUDIT
// =============================================================================

/// Immutable, hash-chained record of every state-changing action across
/// every context (security-model.md § Audit Strategy). Append-only: no
/// application code path may UPDATE or DELETE a row here — enforced by a
/// REVOKE on those privileges for the application's database role in
/// production (see database-architecture.md).
model AuditLog {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId   String?         @map("actor_user_id") @db.Uuid
  actorType     ActorType?      @map("actor_type")
  actionType    AuditActionType @map("action_type")
  resourceType  String          @map("resource_type")
  resourceId    String?         @map("resource_id")
  description   String?
  beforeState   Json?           @map("before_state")
  afterState    Json?           @map("after_state")
  ipAddress     String?         @map("ip_address")
  correlationId String?         @map("correlation_id")
  integrityHash String          @map("integrity_hash")
  previousHash  String?         @map("previous_hash")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  actor              User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  auditNotifications AuditNotification[]

  @@index([actorUserId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Lightweight, high-volume general activity tracking — distinct from
/// `AuditLog`, which is reserved for compliance-significant actions.
model ActivityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  activity  String
  metadata  Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("activity_logs")
}

model SecurityEvent {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?           @map("user_id") @db.Uuid
  eventType SecurityEventType @map("event_type")
  deviceId  String?           @map("device_id") @db.Uuid
  ipAddress String?           @map("ip_address")
  riskScore Decimal?          @map("risk_score") @db.Decimal(5, 2)
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, eventType])
  @@index([createdAt])
  @@map("security_events")
}

model LoginHistory {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  sessionId     String?  @map("session_id") @db.Uuid
  deviceId      String?  @map("device_id") @db.Uuid
  ipAddress     String   @map("ip_address")
  userAgent     String?  @map("user_agent")
  successful    Boolean
  failureReason String?  @map("failure_reason")
  loggedInAt    DateTime @default(now()) @map("logged_in_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  device  Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, loggedInAt])
  @@map("login_history")
}

// =============================================================================
// API
// =============================================================================

model ApiKey {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String?      @map("owner_user_id") @db.Uuid
  name        String
  keyHash     String       @unique @map("key_hash")
  keyPrefix   String       @map("key_prefix")
  scopes      String[]
  status      ApiKeyStatus @default(ACTIVE)
  lastUsedAt  DateTime?    @map("last_used_at") @db.Timestamptz(6)
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  ownerUser User? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([keyPrefix])
  @@map("api_keys")
}

model WebhookEndpoint {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String?  @map("owner_user_id") @db.Uuid
  url         String
  secretHash  String   @map("secret_hash")
  eventTypes  String[] @map("event_types")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ownerUser  User?             @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

/// An outbox-style record of a domain event eligible for webhook delivery.
model WebhookEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType  String   @map("event_type")
  payload    Json
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  deliveries WebhookDelivery[]

  @@index([eventType, occurredAt])
  @@map("webhook_events")
}

model WebhookDelivery {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webhookEventId     String                @map("webhook_event_id") @db.Uuid
  webhookEndpointId  String                @map("webhook_endpoint_id") @db.Uuid
  status             WebhookDeliveryStatus @default(PENDING)
  attempts           Int                   @default(0)
  maxAttempts        Int                   @default(8) @map("max_attempts")
  lastAttemptAt      DateTime?             @map("last_attempt_at") @db.Timestamptz(6)
  respondedAt        DateTime?             @map("responded_at") @db.Timestamptz(6)
  responseStatusCode Int?                  @map("response_status_code")
  nextRetryAt        DateTime?             @map("next_retry_at") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  webhookEvent    WebhookEvent    @relation(fields: [webhookEventId], references: [id], onDelete: Cascade)
  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

// =============================================================================
// CONFIGURATION
// =============================================================================

/// Business/product configuration — maker-checker gated (domain-architecture
/// § Configuration `ChangeApprovalPolicy`).
model ApplicationSetting {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  value       String
  valueType   SettingValueType @map("value_type")
  description String?
  isSecret    Boolean          @default(false) @map("is_secret")
  updatedBy   String?          @map("updated_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedByUser User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("application_settings")
}

/// Lower-level system/infra toggles — distinct from `ApplicationSetting`
/// (business config) per the Phase 2B brief listing both explicitly.
model SystemSetting {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  value       String
  valueType   SettingValueType @map("value_type")
  description String?
  updatedBy   String?          @map("updated_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedByUser User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model FeatureFlag {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key               String           @unique
  name              String
  description       String?
  isEnabled         Boolean          @default(false) @map("is_enabled")
  scope             FeatureFlagScope @default(GLOBAL)
  scopeReference    String?          @map("scope_reference")
  rolloutPercentage Int?             @map("rollout_percentage")
  updatedBy         String?          @map("updated_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedByUser User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("feature_flags")
}

// =============================================================================
// SUPPORT
// =============================================================================

model SupportCategory {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @unique
  description String?
  isActive    Boolean @default(true) @map("is_active")

  tickets SupportTicket[]

  @@map("support_categories")
}

model SupportTicket {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketNumber String         @unique @map("ticket_number")
  customerId   String?        @map("customer_id") @db.Uuid
  categoryId   String         @map("category_id") @db.Uuid
  subject      String
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  assignedTo   String?        @map("assigned_to") @db.Uuid
  slaDeadline  DateTime?      @map("sla_deadline") @db.Timestamptz(6)
  resolvedAt   DateTime?      @map("resolved_at") @db.Timestamptz(6)
  closedAt     DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  category       SupportCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignedToUser User?           @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  messages       TicketMessage[]

  @@index([customerId])
  @@index([status])
  @@index([ticketNumber])
  @@map("support_tickets")
}

model TicketMessage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId       String    @map("ticket_id") @db.Uuid
  authorId       String?   @map("author_id") @db.Uuid
  authorType     ActorType @map("author_type")
  message        String
  isInternalNote Boolean   @default(false) @map("is_internal_note")
  attachmentUrl  String?   @map("attachment_url")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("ticket_messages")
}
