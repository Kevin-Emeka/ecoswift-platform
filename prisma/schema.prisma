// =============================================================================

model LoanProduct {
  id                        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                      String                    @unique
  name                      String
  description               String?
  minAmount                 Decimal                   @map("min_amount") @db.Decimal(19, 4)
  maxAmount                 Decimal                   @map("max_amount") @db.Decimal(19, 4)
  interestRate              Decimal                   @map("interest_rate") @db.Decimal(6, 4)
  interestCalculationMethod InterestCalculationMethod @map("interest_calculation_method")
  minTermMonths             Int                       @map("min_term_months")
  maxTermMonths             Int                       @map("max_term_months")
  requiredTier              KycTier                   @map("required_tier")
  isActive                  Boolean                   @default(true) @map("is_active")

  applications LoanApplication[]
  loans        Loan[]

  @@map("loan_products")
}

model LoanApplication {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId          String     @map("customer_id") @db.Uuid
  loanProductId       String     @map("loan_product_id") @db.Uuid
  requestedAmount     Decimal    @map("requested_amount") @db.Decimal(19, 4)
  requestedTermMonths Int        @map("requested_term_months")
  status              LoanStatus @default(DRAFT)
  eligibilityScore    Decimal?   @map("eligibility_score") @db.Decimal(5, 2)
  decisionBy          String?    @map("decision_by") @db.Uuid
  decisionAt          DateTime?  @map("decision_at") @db.Timestamptz(6)
  rejectionReason     String?    @map("rejection_reason")
  submittedAt         DateTime?  @map("submitted_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer       Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  loanProduct    LoanProduct @relation(fields: [loanProductId], references: [id], onDelete: Restrict)
  decisionByUser User?       @relation(fields: [decisionBy], references: [id], onDelete: SetNull)
  loan           Loan?

  @@index([customerId])
  @@index([status])
  @@map("loan_applications")
}

model Loan {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanApplicationId     String     @unique @map("loan_application_id") @db.Uuid
  customerId            String     @map("customer_id") @db.Uuid
  loanProductId         String     @map("loan_product_id") @db.Uuid
  disbursementAccountId String     @map("disbursement_account_id") @db.Uuid
  principalAmount       Decimal    @map("principal_amount") @db.Decimal(19, 4)
  interestRate          Decimal    @map("interest_rate") @db.Decimal(6, 4)
  termMonths            Int        @map("term_months")
  outstandingPrincipal  Decimal    @map("outstanding_principal") @db.Decimal(19, 4)
  status                LoanStatus @default(APPROVED)
  disbursedAt           DateTime?  @map("disbursed_at") @db.Timestamptz(6)
  maturityDate          DateTime?  @map("maturity_date") @db.Date
  version               Int        @default(0)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  loanApplication     LoanApplication @relation(fields: [loanApplicationId], references: [id], onDelete: Restrict)
  customer            Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  loanProduct         LoanProduct     @relation(fields: [loanProductId], references: [id], onDelete: Restrict)
  disbursementAccount Account         @relation(fields: [disbursementAccountId], references: [id], onDelete: Restrict)
  repaymentPlan       RepaymentPlan?
  collateral          Collateral[]

  @@index([customerId])
  @@index([status])
  @@map("loans")
}

model RepaymentPlan {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId            String             @unique @map("loan_id") @db.Uuid
  totalInstallments Int                @map("total_installments")
  installmentAmount Decimal            @map("installment_amount") @db.Decimal(19, 4)
  frequency         RepaymentFrequency
  startDate         DateTime           @map("start_date") @db.Date
  generatedAt       DateTime           @default(now()) @map("generated_at") @db.Timestamptz(6)

  loan     Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  schedule RepaymentSchedule[]

  @@map("repayment_plans")
}

/// The individual installment lines of a `RepaymentPlan`.
model RepaymentSchedule {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repaymentPlanId   String                     @map("repayment_plan_id") @db.Uuid
  installmentNumber Int                        @map("installment_number")
  dueDate           DateTime                   @map("due_date") @db.Date
  principalDue      Decimal                    @map("principal_due") @db.Decimal(19, 4)
  interestDue       Decimal                    @map("interest_due") @db.Decimal(19, 4)
  totalDue          Decimal                    @map("total_due") @db.Decimal(19, 4)
  amountPaid        Decimal                    @default(0) @map("amount_paid") @db.Decimal(19, 4)
  status            RepaymentInstallmentStatus @default(SCHEDULED)
  transactionId     String?                    @map("transaction_id") @db.Uuid
  paidAt            DateTime?                  @map("paid_at") @db.Timestamptz(6)

  repaymentPlan RepaymentPlan @relation(fields: [repaymentPlanId], references: [id], onDelete: Cascade)
  transaction   Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([repaymentPlanId, installmentNumber])
  @@index([dueDate, status])
  @@map("repayment_schedules")
}

model Collateral {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loanId         String           @map("loan_id") @db.Uuid
  collateralType CollateralType   @map("collateral_type")
  description    String
  estimatedValue Decimal          @map("estimated_value") @db.Decimal(19, 4)
  currencyId     String           @map("currency_id") @db.Uuid
  status         CollateralStatus @default(PLEDGED)
  pledgedAt      DateTime         @default(now()) @map("pledged_at") @db.Timestamptz(6)
  releasedAt     DateTime?        @map("released_at") @db.Timestamptz(6)

  loan     Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([loanId])
  @@map("collateral")
}

