{
  "name": "@ecoswift/config",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized, validated environment configuration shared across Ecoswift Bank services",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./branding": {
      "types": "./dist/branding.d.ts",
      "default": "./dist/branding.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ecoswift/cache": "workspace:*",
    "@ecoswift/database": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
