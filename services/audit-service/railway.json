{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm db:generate && pnpm exec turbo run build --filter=@ecoswift/audit-service"
  },
  "deploy": {
    "startCommand": "node services/audit-service/dist/main.js",
    "healthcheckPath": "/v1/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
