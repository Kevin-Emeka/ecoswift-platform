# =============================================================================
# Ecoswift Bank - Environment Variables (example)
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecoswift_dev

# --- Cache (Redis) ---
REDIS_URL=redis://localhost:6379
# Cluster mode (production at scale) — see infrastructure/docker/redis-cluster
# and docs/infrastructure.md § Redis Cluster. Leave disabled for local dev.
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=
REDIS_TLS_ENABLED=false

# --- Auth / JWT ---
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme

# --- SMTP (Email) ---
EMAIL_DRIVER=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASSWORD=changeme
SMTP_FROM=noreply@ecoswiftbank.com

# --- SMS (Twilio) ---
SMS_DRIVER=console

# --- AWS ---
AWS_ACCESS_KEY=changeme
AWS_SECRET_KEY=changeme
AWS_REGION=us-east-1
AWS_BUCKET=changeme

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=changeme
TWILIO_AUTH_TOKEN=changeme
TWILIO_PHONE_NUMBER=changeme

# --- Object storage (S3-compatible) ---
# local = filesystem (dev default, no credentials needed). s3 = real S3 or
# an S3-compatible server (MinIO, DigitalOcean Spaces, Cloudflare R2, etc).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.storage
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false

# --- Secrets manager ---
# env = read from this file (dev default). aws = AWS Secrets Manager
# (staging/production) — see docs/infrastructure.md § Secrets Management.
SECRETS_DRIVER=env
SECRETS_AWS_REGION=

# --- Observability ---
METRICS_ENABLED=true
# OpenTelemetry distributed tracing (OTLP exporter). Off by default in dev —
# auto-instrumenting every module has real overhead not worth paying locally.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=

# --- Public surfaces (deployment-specific; shown here are local dev values) ---
# Production: https://api.ecoswiftbank.com
API_BASE_URL=http://localhost:3001
# Production: https://admin.ecoswiftbank.com
ADMIN_PORTAL_URL=http://localhost:3100
# Production: https://www.ecoswiftbank.com — same deployed app as the
# public website (marketing + auth + dashboard all served together), so
# this is deliberately the same URL as the site itself, not app.ecoswiftbank.com
CUSTOMER_PORTAL_URL=http://localhost:3200
# Production: https://developers.ecoswiftbank.com
DEVELOPER_PORTAL_URL=
# Production: https://status.ecoswiftbank.com
STATUS_PAGE_URL=
# Production: https://docs.ecoswiftbank.com
DOCS_URL=

# --- Phase 3C: Enterprise Security ---
# Comma-separated allow-list of origins permitted for cross-origin browser
# requests. Empty = no cross-origin callers allowed (default-deny).
# Production example: https://www.ecoswiftbank.com,https://admin.ecoswiftbank.com
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3200

# AES-256-GCM key for @ecoswift/security's EncryptionService, base64-encoded
# 32 raw bytes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_KEY_PREVIOUS is only set during a key-rotation grace period.
ENCRYPTION_KEY=changeme-generate-a-real-32-byte-key-base64
ENCRYPTION_KEY_PREVIOUS=

# CAPTCHA integration — 'noop' always passes (dev/test default).
CAPTCHA_DRIVER=noop
CAPTCHA_SECRET_KEY=
CAPTCHA_MIN_SCORE=0.5

# Request body size ceiling.
REQUEST_BODY_LIMIT=100kb
